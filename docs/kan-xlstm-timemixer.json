      "id": "paper:kan",
      "kind": "paper",
      "label": "KAN: Kolmogorov-Arnold Networks",
      "summary": "원 논문과 공식 구현 KindXiaoming/pykan",
      "reference_year": 2024,
      "url": "https://arxiv.org/abs/2404.19756",
      "authors": [
        "Ziming Liu",
        "Yixuan Wang",
        "Sachin Vaidya",
        "Fabian Ruehle",
        "James Halverson",
        "Marin Soljačić",
