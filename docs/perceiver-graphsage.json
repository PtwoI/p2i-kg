{
  "schema_version": "0.2",
  "nodes": [
    {
      "id": "paper:perceiver",
      "kind": "paper",
      "label": "Perceiver: General Perception with Iterative Attention",
      "summary": "비대칭 어텐션으로 대규모 입력을 작은 잠재 배열에 증류하는 일반 지각 아키텍처의 원논문.",
      "reference_year": 2021,
      "url": "https://proceedings.mlr.press/v139/jaegle21a.html",
      "authors": [
        "Andrew Jaegle",
        "Felix Gimeno",
        "Andrew Brock",
        "Andrew Zisserman",
        "Oriol Vinyals",
        "João Carreira"
      ]
    },
    {
      "id": "paper:graphsage",
      "kind": "paper",
      "label": "Inductive Representation Learning on Large Graphs",
      "summary": "이웃 특징을 표본화하고 집계하는 함수로 보지 못한 노드의 표현을 생성하는 GraphSAGE 원논문.",
      "reference_year": 2017,
      "url": "https://arxiv.org/abs/1706.02216",
      "authors": [
        "William L. Hamilton",
        "Rex Ying",
        "Jure Leskovec"
      ]
    },
    {
      "id": "model:perceiver",
      "kind": "model",
      "label": "Perceiver",
      "summary": "입력 크기와 독립적인 작은 잠재 배열이 비대칭 교차 어텐션으로 다양한 모달리티를 처리합니다.",
      "reference_year": 2021,
      "family": "multimodal",
      "runtime_id": "perceiver",
      "runtime_note": "12개의 8차원 입력을 4개의 학습 잠재 벡터로 증류한 뒤 잠재 self-attention과 분류기를 실행합니다. 길이를 바꿔도 잠재 병목 크기는 고정되는 무작위 초기화 구조 예제입니다.",
      "aliases": [
        "Perceiver"
      ]
    },
    {
      "id": "model:graphsage",
      "kind": "model",
      "label": "GraphSAGE",
      "summary": "노드 자체 특징과 표본화한 이웃 특징의 학습 가능한 집계 함수로 보지 못한 노드의 표현을 생성합니다.",
      "reference_year": 2017,
      "family": "graph",
      "runtime_id": "graphsage",
      "runtime_note": "5개 노드의 전체 이웃 평균을 사용해 표본화 변동을 없앤 GraphSAGE-mean 한 층 예제입니다. 자체·이웃 변환과 노드 분류기를 별도 P2I 모듈로 노출합니다.",
      "aliases": [
        "Graph SAGE",
        "Sample and Aggregate"
      ]
    },
    {
      "id": "concept:latent_bottleneck",
      "kind": "concept",
      "label": "Latent bottleneck",
      "summary": "입력 크기보다 작은 고정 크기 잠재 배열에서 대부분의 처리를 수행합니다."
    },
    {
      "id": "concept:asymmetric_attention",
      "kind": "concept",
      "label": "Asymmetric attention",
      "summary": "작은 잠재 질의가 큰 입력을 key/value로 조회해 계산량을 입력 크기에 선형으로 제한합니다."
    },
    {
      "id": "concept:modality_agnostic_input",
      "kind": "concept",
      "label": "Modality-agnostic input",
      "summary": "격자 등 특정 입력 구조를 가정하지 않고 바이트나 좌표화된 입력 특징을 처리합니다."
    },
    {
      "id": "concept:inductive_graph_learning",
      "kind": "concept",
      "label": "Inductive graph learning",
      "summary": "훈련에 없던 노드나 그래프에도 공유 집계 함수를 적용해 표현을 생성합니다."
    },
    {
      "id": "concept:neighborhood_sampling",
      "kind": "concept",
      "label": "Neighborhood sampling",
      "summary": "각 계층에서 고정 수의 이웃을 표본화해 계산 범위를 제한합니다."
    },
    {
      "id": "concept:mean_aggregation",
      "kind": "concept",
      "label": "Mean neighborhood aggregation",
      "summary": "이웃 특징을 순서 불변 평균으로 결합합니다."
    },
    {
      "id": "concept:sample_and_aggregate",
      "kind": "concept",
      "label": "Sample and aggregate",
      "summary": "이웃 표본화와 집계를 반복해 중심 노드의 표현을 갱신합니다."
    },
    {
      "id": "component:perceiver_input_projection",
      "kind": "component",
      "label": "Perceiver input projection",
      "summary": "입력 특징을 잠재 배열과 같은 채널 폭으로 투영합니다."
    },
    {
      "id": "component:latent_array",
      "kind": "component",
      "label": "Learned latent array",
      "summary": "입력 길이와 무관한 학습 가능한 고정 개수 잠재 질의입니다."
    },
    {
      "id": "component:perceiver_cross_attention",
      "kind": "component",
      "label": "Input-to-latent cross-attention",
      "summary": "잠재 배열이 큰 입력 배열에서 정보를 읽어옵니다."
    },
    {
      "id": "component:latent_processor",
      "kind": "component",
      "label": "Latent Transformer processor",
      "summary": "입력 크기와 무관한 잠재 배열 안에서 self-attention을 수행합니다."
    },
    {
      "id": "component:perceiver_classifier",
      "kind": "component",
      "label": "Perceiver classifier",
      "summary": "처리된 잠재 표현을 모아 분류 점수를 냅니다."
    },
    {
      "id": "component:neighbor_aggregator",
      "kind": "component",
      "label": "Neighborhood aggregator",
      "summary": "노드마다 이웃 특징을 순서 불변 함수로 결합합니다."
    },
    {
      "id": "component:self_projection",
      "kind": "component",
      "label": "GraphSAGE self projection",
      "summary": "중심 노드 자체 특징을 공유 가중치로 변환합니다."
    },
    {
      "id": "component:neighbor_projection",
      "kind": "component",
      "label": "GraphSAGE neighbor projection",
      "summary": "집계한 이웃 특징을 공유 가중치로 변환합니다."
    },
    {
      "id": "component:node_classifier",
      "kind": "component",
      "label": "Node classifier",
      "summary": "각 노드의 GraphSAGE 표현에서 범주 점수를 예측합니다."
    },
    {
      "id": "objective:graph_context_prediction",
      "kind": "objective",
      "label": "Graph context prediction",
      "summary": "관측된 이웃 쌍의 유사도를 높이고 음성 표본의 유사도를 낮추는 비지도 목적입니다."
    },
    {
      "id": "task:unseen_node_representation",
      "kind": "task",
      "label": "Unseen-node representation",
      "summary": "훈련 중 보지 못한 노드나 새 그래프의 특징에서 표현을 생성합니다."
    }
  ],
