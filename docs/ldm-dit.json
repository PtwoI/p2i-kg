{
  "schema_version": "0.2",
  "nodes": [
    {
      "id": "paper:ldm",
      "kind": "paper",
      "label": "High-Resolution Image Synthesis with Latent Diffusion Models",
      "summary": "지각 압축 잠재공간에서 조건부 확산을 수행해 계산량과 충실도를 조절하는 LDM 원논문.",
      "reference_year": 2022,
      "url": "https://openaccess.thecvf.com/content/CVPR2022/html/Rombach_High-Resolution_Image_Synthesis_With_Latent_Diffusion_Models_CVPR_2022_paper.html",
      "authors": ["Robin Rombach", "Andreas Blattmann", "Dominik Lorenz", "Patrick Esser", "Björn Ommer"]
    },
    {
      "id": "paper:dit",
      "kind": "paper",
      "label": "Scalable Diffusion Models with Transformers",
      "summary": "잠재 확산의 U-Net을 조건부 Transformer로 교체하고 계산량에 따른 확장성을 분석한 DiT 원논문.",
      "reference_year": 2023,
      "url": "https://openaccess.thecvf.com/content/ICCV2023/html/Peebles_Scalable_Diffusion_Models_with_Transformers_ICCV_2023_paper.html",
      "authors": ["William Peebles", "Saining Xie"]
    },
    {
      "id": "model:ldm",
      "kind": "model",
      "label": "Latent Diffusion Model",
      "summary": "사전학습한 오토인코더의 압축 잠재공간에서 조건부 U-Net으로 확산 노이즈를 예측합니다.",
      "reference_year": 2022,
      "family": "generative",
      "runtime_id": "ldm",
      "runtime_note": "16×16 이미지를 8채널 8×8 잠재로 압축하고, 작은 조건 인코더·시간 임베딩·U-Net으로 한 번의 잠재 노이즈 예측과 디코딩을 실행합니다. 다단계 샘플링, 학습된 지각 오토인코더, 대규모 텍스트 인코더와 사전학습 가중치는 포함하지 않습니다.",
      "aliases": ["LDM", "Latent Diffusion"]
    },
    {
      "id": "model:dit",
      "kind": "model",
      "label": "Diffusion Transformer",
      "summary": "잠재 패치를 토큰화하고 시간·클래스 조건의 adaLN Transformer 블록으로 확산 노이즈를 예측합니다.",
      "reference_year": 2023,
      "family": "generative",
      "runtime_id": "dit",
      "runtime_note": "4채널 8×8 잠재를 2×2 패치 토큰으로 바꾸고 두 개의 16차원 adaLN 조건부 Transformer 블록으로 한 번의 클래스 조건 노이즈 예측을 실행합니다. VAE, 다단계 샘플러, classifier-free guidance 배치 결합, 대규모 학습과 사전학습 가중치는 포함하지 않습니다.",
      "aliases": ["DiT"]
    },
    {
      "id": "concept:perceptual_compression",
      "kind": "concept",
      "label": "Perceptual compression",
      "summary": "생성에 중요한 정보를 보존하면서 고주파 세부를 제거하는 학습된 압축 공간을 사용합니다."
    },
    {
      "id": "concept:latent_diffusion",
      "kind": "concept",
      "label": "Latent-space diffusion",
      "summary": "픽셀 공간 대신 학습된 저차원 잠재 표현에 순방향·역방향 확산을 적용합니다."
    },
    {
      "id": "concept:cross_attention_conditioning",
      "kind": "concept",
      "label": "Cross-attention conditioning",
      "summary": "텍스트·배치·의미 지도 같은 조건 표현을 교차 어텐션으로 확산 네트워크에 주입합니다."
    },
    {
      "id": "concept:transformer_denoiser",
      "kind": "concept",
      "label": "Transformer denoiser",
      "summary": "합성곱 U-Net 대신 잠재 패치 토큰의 Transformer가 확산 예측을 수행합니다."
    },
    {
      "id": "concept:adaptive_layer_norm",
      "kind": "concept",
      "label": "Adaptive layer normalization",
      "summary": "시간과 클래스 조건에서 정규화의 이동·크기와 잔차 게이트를 생성합니다."
    },
    {
      "id": "component:first_stage_encoder",
      "kind": "component",
      "label": "First-stage image encoder",
      "summary": "이미지를 확산이 실행되는 공간 잠재 표현으로 압축합니다."
    },
    {
      "id": "component:first_stage_decoder",
      "kind": "component",
      "label": "First-stage image decoder",
      "summary": "확산 잠재 표현을 다시 이미지 공간으로 복원합니다."
    },
    {
      "id": "component:conditioning_encoder",
      "kind": "component",
      "label": "Conditioning encoder",
      "summary": "조건 입력을 확산 네트워크가 사용할 문맥 표현으로 변환합니다."
    },
    {
      "id": "component:latent_denoiser",
      "kind": "component",
      "label": "Latent U-Net denoiser",
      "summary": "시간과 문맥에 조건부인 잠재공간 노이즈 예측 U-Net입니다."
    },
    {
      "id": "component:diffusion_time_embedding",
      "kind": "component",
      "label": "Diffusion timestep embedding",
      "summary": "현재 잡음 수준을 신경망의 조건 벡터로 변환합니다."
    },
    {
      "id": "component:latent_patch_embed",
      "kind": "component",
      "label": "Latent patch embedding",
      "summary": "공간 잠재를 고정 크기 패치 토큰 시퀀스로 투영합니다."
    },
    {
      "id": "component:class_embedding",
      "kind": "component",
      "label": "Class condition embedding",
      "summary": "이산 생성 클래스를 Transformer 조건 벡터로 변환합니다."
    },
    {
      "id": "component:adaln_block",
      "kind": "component",
      "label": "adaLN Transformer block",
      "summary": "조건별 정규화·잔차 게이트를 갖는 self-attention과 MLP 블록입니다."
    },
    {
      "id": "component:adaln_modulation",
      "kind": "component",
      "label": "adaLN modulation network",
      "summary": "시간·클래스 조건에서 이동, 크기와 잔차 게이트 파라미터를 생성합니다."
    },
    {
      "id": "component:diffusion_output_head",
      "kind": "component",
      "label": "Diffusion patch output head",
      "summary": "Transformer 토큰을 패치별 확산 예측으로 투영해 공간 잠재로 복원합니다."
    },
    {
      "id": "objective:latent_denoising",
      "kind": "objective",
      "label": "Latent diffusion noise prediction",
      "summary": "잡음이 더해진 잠재와 조건에서 주입된 잡음 또는 관련 확산 목표를 예측합니다."
    },
    {
      "id": "task:conditional_image_generation",
      "kind": "task",
      "label": "Conditional image generation",
      "summary": "텍스트나 클래스 같은 외부 조건에 맞는 이미지를 생성합니다."
    }
  ],
