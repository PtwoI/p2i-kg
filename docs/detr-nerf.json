{
  "schema_version": "0.2",
  "nodes": [
    {"id":"paper:detr","kind":"paper","label":"End-to-End Object Detection with Transformers","summary":"집합 예측과 Transformer 인코더·디코더로 종단간 객체 탐지를 구성한 원논문.","reference_year":2020,"url":"https://arxiv.org/abs/2005.12872","authors":["Nicolas Carion","Francisco Massa","Gabriel Synnaeve","Nicolas Usunier","Alexander Kirillov","Sergey Zagoruyko"]},
    {"id":"paper:nerf","kind":"paper","label":"NeRF: Representing Scenes as Neural Radiance Fields for View Synthesis","summary":"연속 좌표 방사장과 미분 가능한 볼륨 렌더링으로 새로운 시점을 합성한 원논문.","reference_year":2020,"url":"https://arxiv.org/abs/2003.08934","authors":["Ben Mildenhall","Pratul P. Srinivasan","Matthew Tancik","Jonathan T. Barron","Ravi Ramamoorthi","Ren Ng"]},
    {"id":"model:detr","kind":"model","label":"DETR","summary":"학습된 객체 질의를 Transformer 디코더에 넣어 고정 크기 탐지 집합을 병렬 예측합니다.","reference_year":2020,"family":"vision","runtime_id":"detr","runtime_note":"16×16 이미지, 5개 객체 질의, 한 층 인코더·디코더와 3개 객체 클래스. 무작위 초기화된 구조 예제이며 작은 완전탐색 이분 매칭 손실을 제공합니다.","aliases":["DEtection TRansformer"]},
    {"id":"model:nerf","kind":"model","label":"NeRF","summary":"3D 위치와 시선 방향에서 밀도·색을 예측하고 광선을 따라 볼륨 렌더링합니다.","reference_year":2020,"family":"generative","runtime_id":"nerf","runtime_note":"광선 2개와 각 6개 표본, 작은 위치 인코더·MLP·알파 합성기. 계층 표본추출과 실제 카메라 기하는 생략한 무작위 초기화 구조 예제입니다.","aliases":["Neural Radiance Fields"]},
    {"id":"concept:direct_set_prediction","kind":"concept","label":"Direct set prediction","summary":"후처리용 앵커나 NMS 없이 객체 예측 집합을 직접 출력합니다."},
    {"id":"concept:object_queries","kind":"concept","label":"Learned object queries","summary":"각 디코더 슬롯에 고유한 학습 가능 위치 질의를 부여합니다."},
    {"id":"concept:bipartite_matching","kind":"concept","label":"Bipartite matching","summary":"예측 슬롯과 정답 객체 사이의 일대일 최소 비용 대응을 선택합니다."},
    {"id":"concept:radiance_field","kind":"concept","label":"Neural radiance field","summary":"연속 공간 위치와 시선 방향을 밀도와 방출 색으로 매핑합니다."},
    {"id":"concept:fourier_features","kind":"concept","label":"Fourier position features","summary":"좌표를 여러 주파수의 사인·코사인 성분으로 확장합니다."},
    {"id":"concept:volume_rendering","kind":"concept","label":"Differentiable volume rendering","summary":"광선 표본의 밀도에서 투과도와 가중치를 구해 색을 합성합니다."},
    {"id":"concept:view_dependent_radiance","kind":"concept","label":"View-dependent radiance","summary":"같은 공간 위치에서도 시선 방향에 따라 색이 달라지도록 모델링합니다."},
    {"id":"component:detr_backbone","kind":"component","label":"DETR image backbone","summary":"입력을 Transformer 토큰용 공간 특징 지도로 변환합니다."},
    {"id":"component:detr_encoder","kind":"component","label":"DETR Transformer encoder","summary":"공간 특징 사이의 전역 문맥을 자기 어텐션으로 인코딩합니다."},
    {"id":"component:detr_decoder","kind":"component","label":"DETR Transformer decoder","summary":"객체 질의가 인코더 메모리를 교차 어텐션으로 조회합니다."},
    {"id":"component:object_queries","kind":"component","label":"Object query embeddings","summary":"고정 개수 탐지 슬롯의 학습 가능 임베딩입니다."},
    {"id":"component:detection_heads","kind":"component","label":"Set detection heads","summary":"각 질의별 클래스 로짓과 정규화 상자를 예측합니다."},
    {"id":"component:coordinate_encoder","kind":"component","label":"NeRF coordinate encoder","summary":"3D 좌표를 다중 주파수 위치 특징으로 확장합니다."},
    {"id":"component:radiance_mlp","kind":"component","label":"Radiance-field point MLP","summary":"인코딩된 위치에서 밀도와 시점 비의존 특징을 계산합니다."},
    {"id":"component:density_head","kind":"component","label":"Volume-density head","summary":"공간 표본의 부피 밀도를 예측합니다."},
    {"id":"component:view_color_head","kind":"component","label":"View-dependent color head","summary":"공간 특징과 시선 방향을 결합해 RGB를 예측합니다."},
    {"id":"component:volume_renderer","kind":"component","label":"Alpha-compositing renderer","summary":"순서가 있는 광선 표본의 색과 밀도를 한 픽셀로 합성합니다."},
    {"id":"objective:set_prediction_loss","kind":"objective","label":"Bipartite set prediction loss","summary":"이분 매칭 뒤 클래스와 상자 오차를 결합하는 탐지 목적."},
    {"id":"objective:photometric_mse","kind":"objective","label":"Photometric reconstruction MSE","summary":"렌더링한 광선 색과 관측 픽셀 색의 평균 제곱 오차."},
    {"id":"task:object_detection","kind":"task","label":"Object detection","summary":"영상 안 객체의 종류와 경계 상자를 예측합니다."},
    {"id":"task:novel_view_synthesis","kind":"task","label":"Novel-view synthesis","summary":"알려진 카메라 영상으로 학습한 장면의 새 시점을 렌더링합니다."}
  ],
