    {
      "id": "concept:weighted_sum",
      "kind": "concept",
      "label": "가중합",
      "summary": "입력 특징에 가중치를 곱해 합치고 편향을 더하는 연산입니다."
    },
    {
      "id": "concept:activation",
      "kind": "concept",
      "label": "비선형 활성화",
      "summary": "가중합 뒤에 비선형 변환을 적용해 표현력을 높입니다. 임계 함수와 미분 가능한 활성화는 구분합니다."
    },
    {
      "id": "concept:backprop",
      "kind": "concept",
      "label": "역전파",
      "summary": "출력에서 시작한 미분 정보를 연결된 연산으로 전달해 학습 파라미터의 기울기를 구합니다."
    },
    {
      "id": "concept:convolution",
      "kind": "concept",
      "label": "합성곱",
      "summary": "공간의 작은 영역에 필터를 적용해 지역적 패턴을 추출합니다."
    },
    {
      "id": "concept:weight_sharing",
      "kind": "concept",
      "label": "가중치 공유",
      "summary": "서로 다른 위치나 시점에 같은 파라미터를 재사용합니다."
    },
    {
      "id": "concept:recurrence",
      "kind": "concept",
      "label": "순환 상태",
      "summary": "이전 시점의 상태를 다음 시점의 계산에 전달합니다."
    },
    {
      "id": "concept:gating",
      "kind": "concept",
      "label": "게이트",
      "summary": "상태를 유지하거나 갱신하는 정보의 비율을 입력에 따라 조절합니다."
    },
    {
      "id": "concept:memory_cell",
      "kind": "concept",
      "label": "메모리 셀",
      "summary": "LSTM에서 장기 정보를 전달하는 별도의 셀 상태를 사용합니다."
    },
    {
      "id": "concept:residual",
      "kind": "concept",
      "label": "잔차 연결",
      "summary": "변환한 결과에 입력 경로를 더해 정보와 기울기의 전달 경로를 만듭니다."
    },
    {
      "id": "concept:self_attention",
      "kind": "concept",
      "label": "Self-Attention",
      "summary": "같은 입력 시퀀스에서 만든 query, key, value를 이용해 위치 사이의 정보를 결합합니다."
    },
    {
      "id": "concept:position",
      "kind": "concept",
      "label": "위치 정보",
      "summary": "순서 정보가 필요한 Attention 모델에 위치를 표현하는 신호를 더합니다."
    },
    {
      "id": "concept:ffn",
      "kind": "concept",
      "label": "위치별 FFN",
      "summary": "각 위치의 표현에 동일한 피드포워드 변환을 적용합니다."
    },
    {
      "id": "model:perceptron",
      "kind": "model",
      "label": "Perceptron",
      "reference_year": 1958,
      "family": "feedforward",
      "summary": "가중합과 임계 판단으로 이진 출력을 만드는 단일 유닛부터 살펴봅니다. 임계 연산은 일반적인 역전파로 학습하지 않습니다.",
      "runtime_id": "perceptron",
      "runtime_note": "실제 임계 출력을 사용하는 작은 예제입니다. 미분 불가능한 출력이므로 backward 검증은 지원하지 않습니다."
    },
